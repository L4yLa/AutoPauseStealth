  <!-- Packs Plugins\$(AssemblyName).dll into release\$(AssemblyName)_v<version>_bs<gameVersion>.7z on Release builds.
       Set DisableSevenZipRelease=True to skip, or SevenZipExe=<path> to use another 7z.exe. -->
  <Target Name="SevenZipRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' AND '$(DisableSevenZipRelease)' != 'True'">
    <GetManifestInfo ErrorOnMismatch="True">
      <Output TaskParameter="PluginVersion" PropertyName="ReleasePluginVersion" />
      <Output TaskParameter="GameVersion" PropertyName="ReleaseGameVersion" />
    </GetManifestInfo>
    <Error Condition="!Exists('$(SevenZipExe)')" Text="7z.exe not found: $(SevenZipExe) (set SevenZipExe, or DisableSevenZipRelease=True to skip packaging)" />
    <PropertyGroup>
      <_SevenZipStage>$(ProjectDir)$(IntermediateOutputPath)7z\</_SevenZipStage>
      <_SevenZipArchive>$(ReleaseArchiveDir)$(AssemblyName)_v$(ReleasePluginVersion)_bs$(ReleaseGameVersion).7z</_SevenZipArchive>
    </PropertyGroup>
    <RemoveDir Directories="$(_SevenZipStage)" />
    <Copy SourceFiles="$(ProjectDir)$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(_SevenZipStage)Plugins" />
    <MakeDir Directories="$(ReleaseArchiveDir)" />
    <Delete Files="$(_SevenZipArchive)" />
    <Exec Command="&quot;$(SevenZipExe)&quot; a -t7z -mx=9 &quot;$(_SevenZipArchive)&quot; Plugins" WorkingDirectory="$(_SevenZipStage)" StandardOutputImportance="low" />
    <Message Importance="high" Text="Release archive: $(_SevenZipArchive)" />
  </Target>
